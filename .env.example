# Public URL (no trailing slash). Set the production/custom domain on Vercel.
SITE_URL=http://localhost:3000
# Set a unique username, a random password of at least 16 characters,
# and a random session secret of at least 32 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Create these resources in YOUR Cloudflare account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
# API token restricted to Account / D1 / Edit for your account.
CLOUDFLARE_D1_API_TOKEN=
# R2 S3 credentials restricted to your bucket, Object Read & Write.
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
